# Copy this file to .env.local for local development (see docs/SETUP.md) and
# to your hosting provider's environment settings for production. Variable
# NAMES only — no real secret values belong in source control.

# --- Supabase ---
# Local dev: printed by `supabase start` / `supabase status -o env`.
# Production: from your hosted Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key — bypasses Row Level Security. NEVER prefix with
# NEXT_PUBLIC_, never send to the browser, never commit a real value.
SUPABASE_SECRET_KEY=

# Direct Postgres connection string, used by migration/seed tooling.
DATABASE_URL=

# Local-only: Inbucket URL for previewing auth emails (not used in production,
# where a real SMTP provider is configured in the hosted Supabase project).
SUPABASE_INBUCKET_URL=

# --- App ---
# Canonical site origin, used for auth redirects and absolute URL building.
NEXT_PUBLIC_SITE_URL=
